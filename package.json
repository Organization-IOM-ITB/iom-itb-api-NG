{
  "name": "api.iom-itb.id",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon src/index.js",
    "lint": "eslint --fix src",
    "create:db": "npx sequelize-cli db:create --config src/config/config.js",
    "migrate": "npx sequelize-cli db:migrate --config src/config/config.js",
    "migrate:undo": "npx sequelize-cli db:migrate:undo:all --config src/config/config.js",
    "seed": "npx sequelize-cli db:seed:all --config src/config/config.js",
    "migrate:fresh:seed": "npx sequelize-cli db:migrate:undo:all --config src/config/config.js && npx sequelize-cli db:migrate --config src/config/config.js && npx sequelize-cli db:seed:all --config src/config/config.js",
    "legacy:activities:dry-run": "node scripts/importLegacyActivities.js --dry-run --file=./activities.json --report=./migration-reports/activities-dry-run.json",
    "legacy:activities:apply": "node scripts/importLegacyActivities.js --apply --file=./activities.json --report=./migration-reports/activities-apply.json",
    "start:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "stop:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "start:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up -d",
    "stop:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml down"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/local-auth": "^2.1.0",
    "@vueup/vue-quill": "^1.2.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-list-endpoints": "^7.1.0",
    "googleapis": "^140.0.0",
    "helmet": "^7.1.0",
    "http-status-code": "^2.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.1",
    "joi-image-extension": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^2.1.4",
    "midtrans-client": "^1.4.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "path-to-regexp": "^7.0.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sanitize-html": "^2.17.3",
    "sequelize": "^6.37.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^9.4.0",
    "nodemon": "^3.1.3",
    "sequelize-cli": "^6.6.2"
  }
}
